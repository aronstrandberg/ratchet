{
  "name": "ratchet",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CELLD_ESBUILD=$PWD/node_modules/@esbuild/linux-x64/bin/esbuild celld dev . --port 9876",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "rumdl fmt .",
    "fmt:check": "rumdl check .",
    "check": "oxlint && rumdl check . && tsc --noEmit && bun test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@effect/sql-sqlite-bun": "4.1.4",
    "@oxlint/plugins": "1.93.0",
    "@types/bun": "^1.4.4",
    "esbuild": "^0.28.2",
    "oxlint": "1.93.0",
    "rumdl": "0.3.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@effect/platform-cloudflare": "4.1.4",
    "effect": "4.1.4",
    "effect-machine": "0.32.1"
  }
}
